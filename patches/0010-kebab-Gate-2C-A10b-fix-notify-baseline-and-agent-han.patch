From d57ec963e80b766814b4e489b349c27cbdbd1087 Mon Sep 17 00:00:00 2001
From: bringup <bringup@local>
Date: Wed, 21 Oct 2026 17:31:43 +0800
Subject: [PATCH 10/38] kebab: Gate-2C-A10b fix notify baseline and
 agent-handle pairing

- BASELINE snapshot taken before RegisterProtocolNotify. EDK2 Notify.c sets
  ProtNotify->Position = &ProtEntry->Protocols, so the first callback re-walks
  every pre-existing instance; without a baseline those would be misread as
  new installs.
- Callback now counts callbacks/seen/new separately; newly seen handles are
  remembered so they are never double-counted, and only genuinely new ones
  print [USBCFG/NOTIFY] ... NEW.
- All identity lookups (LoadedImage, DriverBinding) now use
  OpenProtocol(GET_PROTOCOL)/CloseProtocol with our own AgentHandle;
  HandleProtocol is gone (it opens as gDxeCoreImageHandle and cannot be
  closed by us). Close status is checked and printed on failure.
- AgentHandle is no longer equated with ImageHandle: both ImageHandle and
  DriverBindingHandle are printed, UNKNOWN reported when unresolvable.
---
 .../Drivers/RamManagerDxe/RamManager.c        | 208 +++++++++++++-----
 1 file changed, 156 insertions(+), 52 deletions(-)

diff --git a/Silicon/Silicium/SiliciumPkg/Drivers/RamManagerDxe/RamManager.c b/Silicon/Silicium/SiliciumPkg/Drivers/RamManagerDxe/RamManager.c
index 455bd3d9..88865de2 100644
--- a/Silicon/Silicium/SiliciumPkg/Drivers/RamManagerDxe/RamManager.c
+++ b/Silicon/Silicium/SiliciumPkg/Drivers/RamManagerDxe/RamManager.c
@@ -429,17 +429,71 @@ UsbDevConfigFields (
 }
 
 //
-// Gate-2C-A10: passive diagnostics for USB Config publication timing and
-// protocol ownership. STRICTLY PASSIVE:
-//   - never calls any vendor Driver Binding Supported()/Start()
-//   - never calls ConnectController()/DisconnectController()
-//   - never opens BY_DRIVER
-//   - never touches PMIC/MMIO
+// Gate-2C-A10b: passive diagnostics, corrected.
+//   - BASELINE snapshot separates pre-existing instances from real notifications
+//     (EDK2 Notify.c sets ProtNotify->Position = &ProtEntry->Protocols, so the
+//      first callback re-walks every existing instance).
+//   - All identity lookups use OpenProtocol(GET_PROTOCOL)/CloseProtocol with a
+//     matched AgentHandle; no HandleProtocol (which opens as gDxeCoreImageHandle).
+//   - Strictly passive: no Supported()/Start()/ConnectController/BY_DRIVER.
 //
-STATIC UINT32     mUsbCfgNotifySeq = 0;
-STATIC EFI_EVENT  mUsbCfgNotifyEvt = NULL;
+#define USBD_BASELINE_MAX  8
+
+STATIC UINT32     mUsbCfgNotifySeq   = 0;   // notifications that actually fired
+STATIC UINT32     mUsbCfgSeenCount   = 0;   // handles reported total
+STATIC UINT32     mUsbCfgNewCount    = 0;   // handles NOT in baseline
+STATIC EFI_HANDLE mUsbCfgBaseline[USBD_BASELINE_MAX];
+STATIC UINT32     mUsbCfgBaselineCount = 0;
+STATIC EFI_EVENT  mUsbCfgNotifyEvt   = NULL;
 STATIC EFI_GUID   mUsbdDriverBindingGuid = { 0x18A031AB, 0xB443, 0x4D1A, { 0xA5, 0xC0, 0x0C, 0x09, 0x26, 0x1E, 0x9F, 0x71 }};
 
+STATIC
+BOOLEAN
+UsbdIsBaseline (
+  IN EFI_HANDLE Handle
+  )
+{
+  for (UINTN i = 0; i < mUsbCfgBaselineCount; i++) {
+    if (mUsbCfgBaseline[i] == Handle) {
+      return TRUE;
+    }
+  }
+  return FALSE;
+}
+
+STATIC
+VOID
+UsbdPrintCoreFields (
+  IN CONST CHAR8 *Kind,
+  IN UINT32       Seq,
+  IN EFI_HANDLE   Handle
+  )
+{
+  EFI_STATUS Status;
+  UINT8     *Ifc = NULL;
+  UINT32     F88;
+  UINT32     F8C;
+  EFI_STATUS CloseSt;
+
+  Status = gBS->OpenProtocol (Handle, &mUsbdUsbConfigGuid, (VOID **)&Ifc,
+                              gImageHandle, NULL, EFI_OPEN_PROTOCOL_GET_PROTOCOL);
+  if (EFI_ERROR (Status) || (Ifc == NULL)) {
+    DEBUG ((EFI_D_ERROR, "[USBCFG/%a] Seq=%d Handle=%p OpenStatus=%r (no read)\n",
+            Kind, Seq, Handle, Status));
+    return;
+  }
+
+  F88 = ReadUnaligned32 ((UINT32 *)(Ifc + 0x88));
+  F8C = ReadUnaligned32 ((UINT32 *)(Ifc + 0x8C));
+  DEBUG ((EFI_D_ERROR, "[USBCFG/%a] Seq=%d Handle=%p Core=%d Field88=0x%08x Field8C=0x%08x\n",
+          Kind, Seq, Handle, F88, F88, F8C));
+
+  CloseSt = gBS->CloseProtocol (Handle, &mUsbdUsbConfigGuid, gImageHandle, NULL);
+  if (EFI_ERROR (CloseSt)) {
+    DEBUG ((EFI_D_ERROR, "[USBCFG/%a] Seq=%d Close=%r  <== UNBALANCED\n", Kind, Seq, CloseSt));
+  }
+}
+
