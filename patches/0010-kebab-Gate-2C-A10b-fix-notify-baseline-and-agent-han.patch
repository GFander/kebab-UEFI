 }
 
@@ -534,6 +602,36 @@ UsbDevConfigOpenDetails (
   FreePool (Handles);
 }
 
+STATIC
+VOID
+UsbCfgBaselineSnapshot (
+  VOID
+  )
+{
+  EFI_STATUS  St;
+  EFI_HANDLE *Handles = NULL;
+  UINTN       Count   = 0;
+
+  mUsbCfgBaselineCount = 0;
+
+  St = gBS->LocateHandleBuffer (ByProtocol, &mUsbdUsbConfigGuid, NULL, &Count, &Handles);
+  if (EFI_ERROR (St) || (Handles == NULL)) {
+    DEBUG ((EFI_D_ERROR, "[USBCFG/BASELINE] none or error %r\n", St));
+    return;
+  }
+
+  for (UINTN i = 0; i < Count; i++) {
+    if (mUsbCfgBaselineCount < USBD_BASELINE_MAX) {
+      mUsbCfgBaseline[mUsbCfgBaselineCount++] = Handles[i];
+    }
+    UsbdPrintCoreFields ("BASELINE", (UINT32)(i + 1), Handles[i]);
+  }
+  DEBUG ((EFI_D_ERROR, "[USBCFG/BASELINE] count=%d (pre-existing, registered before any callback)\n",
+          (UINT32)mUsbCfgBaselineCount));
+
+  FreePool (Handles);
+}
+
 STATIC
 VOID
 EFIAPI
@@ -545,36 +643,36 @@ UsbCfgNotifyCallback (
   EFI_STATUS  St;
   EFI_HANDLE  Handle;
   UINTN       Size;
-  UINT8      *Ifc;
-  UINT32      F88;
-  UINT32      F8C;
-  EFI_STATUS  CloseSt;
+
+  mUsbCfgNotifySeq++;
+  DEBUG ((EFI_D_ERROR, "[USBCFG/NOTIFY] Callback=%d begin\n", mUsbCfgNotifySeq));
 
   for (;;) {
     Handle = NULL;
     Size   = sizeof (Handle);
     St     = gBS->LocateHandle (ByRegisterNotify, NULL, Event, &Size, &Handle);
     if (EFI_ERROR (St)) {
-      break;   // no more notifications for this event
+      break;
     }
 
-    mUsbCfgNotifySeq++;
+    mUsbCfgSeenCount++;
 
-    Ifc = NULL;
-    St  = gBS->OpenProtocol (Handle, &mUsbdUsbConfigGuid, (VOID **)&Ifc,
-                             gImageHandle, NULL, EFI_OPEN_PROTOCOL_GET_PROTOCOL);
-    if (!EFI_ERROR (St) && (Ifc != NULL)) {
-      F88 = ReadUnaligned32 ((UINT32 *)(Ifc + 0x88));
-      F8C = ReadUnaligned32 ((UINT32 *)(Ifc + 0x8C));
-      DEBUG ((EFI_D_ERROR, "[USBCFG/NOTIFY] Sequence=%d Handle=%p Field88=0x%08x Field8C=0x%08x\n",
-              mUsbCfgNotifySeq, Handle, F88, F8C));
-      CloseSt = gBS->CloseProtocol (Handle, &mUsbdUsbConfigGuid, gImageHandle, NULL);
-      DEBUG ((EFI_D_ERROR, "[USBCFG/NOTIFY] Sequence=%d Close=%r\n", mUsbCfgNotifySeq, CloseSt));
+    if (UsbdIsBaseline (Handle)) {
+      DEBUG ((EFI_D_ERROR, "[USBCFG/NOTIFY] Callback=%d Handle=%p -> pre-existing (see BASELINE), not a new install\n",
+              mUsbCfgNotifySeq, Handle));
     } else {
-      DEBUG ((EFI_D_ERROR, "[USBCFG/NOTIFY] Sequence=%d Handle=%p OpenStatus=%r (no read)\n",
-              mUsbCfgNotifySeq, Handle, St));
+      mUsbCfgNewCount++;
+      if (mUsbCfgBaselineCount < USBD_BASELINE_MAX) {
+        mUsbCfgBaseline[mUsbCfgBaselineCount++] = Handle;   // remember so we never double-count
+      }
+      DEBUG ((EFI_D_ERROR, "[USBCFG/NOTIFY] Callback=%d Handle=%p -> NEW install (#%d)\n",
+              mUsbCfgNotifySeq, Handle, mUsbCfgNewCount));
+      UsbdPrintCoreFields ("NOTIFY", mUsbCfgNotifySeq, Handle);
     }
   }
+
+  DEBUG ((EFI_D_ERROR, "[USBCFG/NOTIFY] Callback=%d end (seenTotal=%d newTotal=%d)\n",
+          mUsbCfgNotifySeq, mUsbCfgSeenCount, mUsbCfgNewCount));
 }
 
