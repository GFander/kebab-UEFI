+STATIC EFI_STATUS EFIAPI XnuUfsFree (EDKII_UFS_HOST_CONTROLLER_PROTOCOL *T, UINTN Pg, VOID *Ha)
+{
+  XnuUfsPoolFree (Ha, Pg);
+  return EFI_SUCCESS;
+}
