+STATIC KEBAB_FWLOG *mKebabFwLog = (KEBAB_FWLOG *)(UINTN)KEBAB_FWLOG_PA;
+
+STATIC
+VOID
+KebabFwLogAppend (
+  IN CONST UINT8  *Buffer,
+  IN UINTN        Length
+  )
+{
+  UINT64 Head;
+  UINTN  Index;
+
+  if (Buffer == NULL || Length == 0) {
+    return;
+  }
+  if (mKebabFwLog->Magic != KEBAB_FWLOG_MAGIC) {
+    return;
+  }
+  Head = __atomic_load_n (&mKebabFwLog->Head, __ATOMIC_RELAXED);
+  for (Index = 0; Index < Length; Index++) {
+    mKebabFwLog->Data[(Head + Index) % KEBAB_FWLOG_DATA_SIZE] = Buffer[Index];
+  }
+  __atomic_store_n (&mKebabFwLog->Head, Head + Length, __ATOMIC_RELEASE);
+}
