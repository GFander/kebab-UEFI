+STATIC
+VOID
+XnuCheckLoader (
+  VOID
+  )
+{
+  EFI_GUID    LoaderGuid = { 0x0f0a492e, 0x5a6a, 0x49f6,
+                             { 0xa1, 0xbf, 0x74, 0x3c, 0x87, 0xab, 0x1c, 0xfe } };
+  VOID        *Loader = NULL;
