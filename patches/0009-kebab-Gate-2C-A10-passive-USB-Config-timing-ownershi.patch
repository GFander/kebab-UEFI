-  UsbDevConfigFields ("");
+  UsbDevReport ("#1-early");
+  UsbDevConfigFields ("#1-early");
+  UsbDevConfigOpenDetails ("#1-early");
+  UsbDevArmConfigNotify ();
   UsbDevArmReadyToBoot ();
 
