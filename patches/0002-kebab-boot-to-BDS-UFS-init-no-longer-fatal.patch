 .../kebabPkg/Library/ConfigurationMapLib/ConfigurationMapLib.c  | 2 +-
 Platforms/OnePlus/kebabPkg/Library/MemoryMapLib/MemoryMapLib.c  | 2 ++
 2 files changed, 3 insertions(+), 1 deletion(-)

