+STATIC
+VOID
+DumpProtocolCount (
+  IN CONST CHAR8 *Name,
+  IN EFI_GUID    *Guid
+  )
+{
+  EFI_STATUS  Status;
+  EFI_HANDLE *Handles = NULL;
+  UINTN       Count   = 0;
+
+  Status = gBS->LocateHandleBuffer (ByProtocol, Guid, NULL, &Count, &Handles);
+  if (EFI_ERROR (Status)) {
+    Count = 0;
+  }
+
+  DEBUG ((EFI_D_ERROR, "[DIAG] %a = %d\n", Name, (UINT32)Count));
+
+  if (Handles != NULL) {
+    FreePool (Handles);
+  }
+}
+
