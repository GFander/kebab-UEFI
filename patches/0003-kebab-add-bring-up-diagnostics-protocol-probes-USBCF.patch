+  DiagDumpProtocols ();
+  DumpUsbfnPrereq ();
+  DumpUsbCfgCandidates ();
+
+  // Arm a one-shot dump that fires after BDS has connected all drivers
+  DiagArmDeferredDump ();
+
   // Get EFI Memory Map
   Status = GetEfiMemoryMap ();
   if (EFI_ERROR (Status)) {
