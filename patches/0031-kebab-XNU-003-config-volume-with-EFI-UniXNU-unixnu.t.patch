From e7b909b893ee80804a2ceffd027dfdd57d47295b Mon Sep 17 00:00:00 2001
From: bringup <bringup@local>
Date: Thu, 22 Oct 2026 00:35:53 +0800
Subject: [PATCH 31/38] kebab: XNU-003 config volume with
 \EFI\UniXNU\unixnu.toml

The RAM disk only carried XNU-TEST.TXT, so UniXNU fell back to its
built-in configuration and reported 'No boot entry found'.

mkfat12_dir.py writes a FAT12 volume with real subdirectories and LFN
entries (unixnu.toml needs a long name - 'toml' does not fit 8.3):
    /EFI/UniXNU/unixnu.toml          version = 1, [boot] timeout=30,
                                     default='hello', one efi entry and one
                                     action entry
    /EFI/UniXNU/Payloads/HELLO.EFI   prebuilt HelloPayload.efi
    /XNU-TEST.TXT                    kept for the XnuRamDiskDxe self-test

kebab.fdf now embeds XnuConfigFat12.img in place of XnuTestFat12.img.
---
 Platforms/OnePlus/kebabPkg/kebab.fdf          |   2 +-
 .../Drivers/XnuRamDiskDxe/XnuConfigFat12.img  | Bin 0 -> 524288 bytes
 .../Drivers/XnuRamDiskDxe/mkfat12_dir.py      | 265 ++++++++++++++++++
 3 files changed, 266 insertions(+), 1 deletion(-)
 create mode 100644 Silicon/Silicium/SiliciumPkg/Drivers/XnuRamDiskDxe/XnuConfigFat12.img
 create mode 100644 Silicon/Silicium/SiliciumPkg/Drivers/XnuRamDiskDxe/mkfat12_dir.py

diff --git a/Platforms/OnePlus/kebabPkg/kebab.fdf b/Platforms/OnePlus/kebabPkg/kebab.fdf
index 9204dfc0..5fbb06be 100644
--- a/Platforms/OnePlus/kebabPkg/kebab.fdf
+++ b/Platforms/OnePlus/kebabPkg/kebab.fdf
@@ -86,7 +86,7 @@ READ_LOCK_STATUS   = TRUE
   # Gate XNU-001a-2: RAM FAT test volume
   INF SiliciumPkg/Drivers/XnuRamDiskDxe/XnuRamDiskDxe.inf
   FILE FREEFORM = 7B1C2A44-5E3D-4F6A-9C11-8E2D4F6A1B23 {
-    SECTION RAW = Silicon/Silicium/SiliciumPkg/Drivers/XnuRamDiskDxe/XnuTestFat12.img
+    SECTION RAW = Silicon/Silicium/SiliciumPkg/Drivers/XnuRamDiskDxe/XnuConfigFat12.img
   }
 
   # XNU-002a: UniXNU boot manager (prebuilt, official sources)
diff --git a/Silicon/Silicium/SiliciumPkg/Drivers/XnuRamDiskDxe/XnuConfigFat12.img b/Silicon/Silicium/SiliciumPkg/Drivers/XnuRamDiskDxe/XnuConfigFat12.img
new file mode 100644
index 0000000000000000000000000000000000000000..d6e33f72268e2890aaea54d22b68c71d79d970c2
GIT binary patch
